# ---------- LLM (主模型：直接采用本地多模态模型或 OpenAI 兼容接口) ----------
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-flash
LLM_BASE_URL=http://127.0.0.1:8083/v1
LLM_API_KEY=local-gemma
LLM_MODEL=gemma-4-E4B-it-Q4_K_M.gguf
# true: 使用原生 function calling; false: 使用 [TOOL_CALL:name:{json}] 文本协议
LLM_USE_NATIVE_TOOLS=true

# ---------- Embedding ----------
# openai_compat | dashscope | local | tfidf
EMBED_PROVIDER=openai_compat
EMBED_BASE_URL=http://127.0.0.1:8084/v1
EMBED_MODEL=bge-small-zh-v1.5-f16.gguf
EMBED_DIM=512
DASHSCOPE_API_KEY=

# ---------- 存储（连接失败将自动降级） ----------
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
REDIS_URL=redis://localhost:6379/0
SQLITE_PATH=data/agent.db

# ---------- Agent ----------
MAX_STEPS=8
CONTEXT_MAX_TOKENS=8000
CONTEXT_RESERVE_RATIO=0.2

# ---------- 联网 / 临时知识库（Staging，可选） ----------
# 总开关：打开后知识库面板出现「联网导入」，并可用 web_tool；默认关闭=纯本地
WEB_ENABLED=false
WEB_FETCH_TIMEOUT=15
WEB_MAX_BYTES=2000000
# 为空表示允许所有公网域名；内网/回环/云元数据地址始终拒绝（测试可用 WEB_ALLOW_LOOPBACK=true）
WEB_ALLOWED_DOMAINS=[]
WEB_ALLOW_LOOPBACK=false
# 搜索发现：none | searxng | tavily（SearXNG 自建最契合本地优先；Tavily 需 API Key）
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_BASE_URL=
WEB_SEARCH_API_KEY=
# 主搜索服务不可用时的兜底：bing（内置免安装，使用 Bing RSS）/ none（严格只用主服务）
WEB_SEARCH_FALLBACK_PROVIDER=bing
# 可选：外部 MCP 搜索服务地址（Streamable HTTP）。项目只内置客户端，不内置 MCP 服务端。
# MCP_WEB_SERVER_URL=http://127.0.0.1:9000/mcp
# MCP_WEB_SEARCH_TOOL=search
# 运行期联网补充（B 通道）：off=关闭；auto=本地 RAG 不足时自动联网补充并暂存临时库
WEB_FALLBACK_MODE=off
WEB_FALLBACK_MAX_SOURCES=2
WEB_FALLBACK_MIN_SIMILARITY=0.55
# 临时知识库
STAGING_TTL_DAYS=7
STAGING_MAX_DOCUMENTS_PER_SESSION=30

# ---------- 服务 ----------
# 本机单用户默认允许全部来源；若通过局域网/公网暴露，请收紧为具体前端来源并设置 API_TOKEN
# CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO

# 可选：API 访问令牌（留空=不鉴权，本地单用户默认）。
# 设置后除 /health 外所有接口需携带 `Authorization: Bearer <token>`，
# 在 WebUI 设置里把 API Key 填成同样的值即可继续访问。
# API_TOKEN=change-me-to-a-long-random-token
