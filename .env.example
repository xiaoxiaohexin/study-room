# ---------- LLM (主模型：直接采用本地多模态模型或 OpenAI 兼容接口) ----------
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-flash
LLM_BASE_URL=http://127.0.0.1:8083/v1
LLM_API_KEY=local-gemma
LLM_MODEL=gemma-4-E4B-it-Q4_K_M.gguf
# true: 使用原生 function calling; false: 使用 [TOOL_CALL:name:{json}] 文本协议
LLM_USE_NATIVE_TOOLS=true

# ---------- Embedding ----------
# openai_compat | dashscope | local | tfidf
EMBED_PROVIDER=openai_compat
EMBED_BASE_URL=http://127.0.0.1:8084/v1
EMBED_MODEL=bge-small-zh-v1.5-f16.gguf
EMBED_DIM=512
DASHSCOPE_API_KEY=

# ---------- 存储（连接失败将自动降级） ----------
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
REDIS_URL=redis://localhost:6379/0
SQLITE_PATH=data/agent.db

# ---------- Agent ----------
MAX_STEPS=8
CONTEXT_MAX_TOKENS=8000
CONTEXT_RESERVE_RATIO=0.2

# ---------- 服务 ----------
CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
